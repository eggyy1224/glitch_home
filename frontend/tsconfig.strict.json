{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": false,
    "checkJs": false,
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "useUnknownInCatchVariables": true,
    "exactOptionalPropertyTypes": true,
    "strictNullChecks": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"]
  },
  "include": [
    "src/types/**/*",
    "src/api.ts",
    "src/appMode/AppModeContext.tsx",
    "src/hooks/useClientStateQueue.ts",
    "src/hooks/useControlSocket.ts",
    "src/hooks/useIframeTimelinePlayer.ts",
    "src/hooks/useRemoteTimelineControl.ts",
    "src/hooks/useTimelineStepActions.ts",
    "src/hooks/useTimelineEpisodeEditor.ts",
    "src/utils/html2canvasLoader.ts",
    "src/utils/request.ts",
    "src/utils/adminEditorUtils.ts",
    "src/components/TimelineEpisodeEditor.tsx",
    "src/components/SnapshotManager.tsx",
    "src/components/TimelineManager.tsx",
    "src/components/EpisodeManager.tsx",
    "src/components/ClientStateQueuePanel.tsx",
    "src/AdminPanel.tsx"
  ]
}
