{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "useUnknownInCatchVariables": true,
    "exactOptionalPropertyTypes": true,
    "strictNullChecks": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": false
  },
  "include": [
    "src/types/**/*",
    "src/api.ts",
    "src/appMode/AppModeContext.tsx",
    "src/hooks/useClientStateQueue.ts",
    "src/hooks/useControlSocket.ts",
    "src/hooks/useIframeTimelinePlayer.ts",
    "src/hooks/useRemoteTimelineControl.ts",
    "src/hooks/useTimelineStepActions.ts"
  ]
}
