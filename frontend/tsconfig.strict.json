{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "useUnknownInCatchVariables": true,
    "exactOptionalPropertyTypes": true,
    "strictNullChecks": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": false
  },
  "include": [
    "src/types/**/*"
  ]
}
